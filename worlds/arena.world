<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="drone_test_world">
    <!-- A directional light to illuminate the arena -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- A flat ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Overhead Tracking Camera.  Four metres keeps the 2.0 m, 1.5 m
         controller target comfortably inside this camera's field of view. -->
    <model name="overhead_tracking_camera">
      <static>true</static>
      <pose>0.0 0.0 4.0 0 1.5707 0</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </visual>
        <sensor name="tracking_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>overhead_camera</namespace>
              <!-- gazebo_ros_camera includes camera_name in its source topic.
                   Remap that source to the topic consumed by the tracker. -->
              <remapping>overhead_camera/image_raw:=image_raw</remapping>
              <remapping>overhead_camera/camera_info:=camera_info</remapping>
            </ros>
            <camera_name>overhead_camera</camera_name>
            <frame_name>camera_link</frame_name>
            </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
